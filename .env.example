# 复制为 .env 后填写。真实凭据（SSH 私钥、SMTP 密码）不要写在这里——部署后在网页的受控入口录入。

SITE_DOMAIN=usage.example.com
PUBLIC_BASE_URL=https://usage.example.com      # 邮件中“查看详情”链接的前缀

POSTGRES_PASSWORD=change-me
JWT_SECRET=                                    # openssl rand -hex 32
# 主加密密钥放在 ./secrets/master_key（openssl rand -base64 32 > secrets/master_key），需独立备份

# 首次启动时创建的管理员；登录后请修改密码并删除 ADMIN_PASSWORD
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

COOKIE_SECURE=true                             # 仅本地 HTTP 调试时设为 false
COLLECT_CONCURRENCY=4                          # 同时采集的目标数
COLLECT_MAX_ATTEMPTS=3                         # 单轮采集的退避重试次数
SSH_TIMEOUT_MS=120000
MAIL_MAX_ATTEMPTS=5
LOG_LEVEL=info

# 可选：SMTP 的环境变量回退（推荐在“系统设置”页面配置，密码会加密入库）
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=usage-monitor@example.com
